<Window x:Class="WavMarker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpectroMark" Width="1500" Height="860" MinWidth="900" MinHeight="500"
        Background="#141414" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#eee"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#1e1e1e" Padding="10,6" BorderBrush="#333" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="26" Foreground="#FFEB3B" Text="0:00.000 / 0:00.000" Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open WAV(s)..." Click="Open_Click"/>
                    <Button x:Name="PlayBtn" Content="Play  (Space)" Click="Play_Click" Width="120"/>
                    <Button Content="Drop Marker  (M)" Click="Marker_Click" Background="#3a3a10" Foreground="#FFEB3B"/>
                    <Button Content="Save" Click="SaveMarkers_Click"/>
                    <Button Content="Save All" Click="SaveAll_Click"/>
                    <TextBlock x:Name="DirtyText" Text="" Foreground="#FFEB3B" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" ToolTip="Unsaved marker changes"/>
                    <CheckBox x:Name="LogFreqChk" Content="Log frequency" IsChecked="True" Foreground="#ccc" VerticalAlignment="Center" Margin="10,0" Checked="Spec_SettingChanged" Unchecked="Spec_SettingChanged"/>
                    <TextBlock Text="Floor dB" Margin="8,0,4,0"/>
                    <Slider x:Name="FloorSlider" Minimum="-130" Maximum="-40" Value="-100" Width="120" VerticalAlignment="Center" ValueChanged="Spec_SettingChanged"/>
                    <TextBlock x:Name="InfoText" Margin="20,0,0,0" Text="Open a WAV file (or drag one in)"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Status / hints -->
        <Border DockPanel.Dock="Bottom" Background="#1e1e1e" Padding="10,3" BorderBrush="#333" BorderThickness="0,1,0,0">
            <TextBlock FontSize="11" Foreground="#888"
                       Text="Ctrl+Z / Ctrl+Shift+Z: undo / redo   Ctrl+S: save markers into WAV   Space: play/pause   M: drop marker   Home: to start   ←/→: nudge 1s   Delete: remove selected marker   |   Left-click/drag: scrub   Wheel: zoom   Shift+Wheel: pan   Middle-drag: pan   |   Right-click a marker and drag to move it"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>
            <!-- File list -->
            <DockPanel Grid.Column="0" Background="#1a1a1a">
                <TextBlock DockPanel.Dock="Top" Text="Files" FontWeight="Bold" Margin="8,6" Foreground="#7FD7FF"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,6">
                    <Button Content="Close" Click="CloseFile_Click" ToolTip="Remove the selected file from the list"/>
                    <Button Content="Close All" Click="CloseAll_Click"/>
                </StackPanel>
                <ListBox x:Name="FileList" Background="#111" Foreground="#eee" BorderThickness="0" FontSize="13"
                         SelectionChanged="FileList_SelectionChanged" DisplayMemberPath="Display" ToolTipService.ShowDuration="20000"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#2a2a2a" Focusable="False"/>
            <Grid Grid.Column="2" x:Name="ViewGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <!-- Overview waveform -->
                <Grid Grid.Row="0" x:Name="OverviewHost" Background="#0c0c0c" ClipToBounds="True"
                      MouseLeftButtonDown="Overview_MouseDown" MouseMove="Overview_MouseMove" MouseLeftButtonUp="Overview_MouseUp">
                    <Image x:Name="OverviewImage" Stretch="Fill"/>
                    <Canvas x:Name="OverviewOverlay" IsHitTestVisible="False"/>
                </Grid>
                <!-- Time ruler -->
                <Canvas Grid.Row="1" x:Name="Ruler" Background="#1a1a1a" ClipToBounds="True"/>
                <!-- Spectrogram -->
                <Grid Grid.Row="2" x:Name="SpecHost" Background="Black" ClipToBounds="True"
                      MouseDown="Spec_MouseDown" MouseMove="Spec_MouseMove" MouseUp="Spec_MouseUp"
                      MouseWheel="Spec_MouseWheel" MouseLeave="Spec_MouseLeave">
                    <Image x:Name="SpecImage" Stretch="Fill"/>
                    <Canvas x:Name="SpecOverlay" IsHitTestVisible="False"/>
                </Grid>
                <ScrollBar Grid.Row="3" x:Name="HScroll" Orientation="Horizontal" Scroll="HScroll_Scroll"/>
            </Grid>
            <!-- Marker list -->
            <DockPanel Grid.Column="3" Background="#1a1a1a">
                <TextBlock DockPanel.Dock="Top" Text="Markers" FontWeight="Bold" Margin="8,6" Foreground="#FFEB3B"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,6">
                    <Button Content="Delete" Click="DeleteMarker_Click"/>
                    <Button Content="Clear all" Click="ClearMarkers_Click"/>
                </StackPanel>
                <ListBox x:Name="MarkerList" Background="#111" Foreground="#eee" BorderThickness="0" FontFamily="Consolas" FontSize="14"
                         SelectionChanged="MarkerList_SelectionChanged" MouseDoubleClick="MarkerList_DoubleClick"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
